# Salin file ini menjadi `.env.local`, lalu isi nilainya.
# Nilai ada di Supabase Dashboard -> Project Settings -> API.
#
# Hanya URL project dan anon/publishable key yang boleh ada di frontend.
# JANGAN PERNAH memasukkan service role key, GEMINI_API_KEY, atau secret lain di sini.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
