# Frontend
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
# ⚠️ IMPORTANT: Use ANON key (role: "anon"), NOT service_role key!
# Both are JWT format (start with eyJ...), check role via:
#   node -e "const k='YOUR_KEY'; console.log(JSON.parse(Buffer.from(k.split('.')[1],'base64url')).role)"
# Get anon key from: Supabase Dashboard > Settings > API > "anon public"

# Test users (optional, untuk testing)
TEST_A_EMAIL=tester-a@example.com
TEST_A_PASSWORD=TestPassword123!
TEST_B_EMAIL=tester-b@example.com
TEST_B_PASSWORD=TestPassword123!

# Supabase CLI (untuk db operations)
SUPABASE_DB_PASSWORD=your_database_password

# Backend (disimpan lewat `supabase secrets set`, bukan di repo)
GEMINI_API_KEY=
GEMINI_MODEL=
GROQ_API_KEY=